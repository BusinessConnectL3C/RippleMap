generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String       @id @default(cuid())
  name          String
  type          OrgType      @default(NONPROFIT)
  arcgisGroupId String?
  clickupListId String?
  // Private Felt project holding this org's maps (one per org, created at
  // registration, best-effort — same pattern as arcgisGroupId/clickupListId).
  feltProjectId String?
  /// Last time the org's Felt project was checked for new or changed maps
  /// (throttles the automatic check when owners/admins open map pages).
  feltSyncedAt  DateTime?
  // Whether this org also uses ArcGIS/Esri (Survey123, Field Maps, hosted
  // feature services). Felt is the default; ArcGIS is opt-in per org.
  arcgisEnabled Boolean      @default(false)
  mediaSource   MediaSource?
  s3Bucket      String?
  s3Prefix      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  users           User[]
  onboardingState OnboardingState?
  supportTickets  SupportTicket[]
  invites         OrgInvite[]
  feltMaps        FeltMap[]
  billing         OrgBilling?
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  hashedPassword  String
  /// Set when the user proves they own `email` (verification link, invite
  /// acceptance, or staff script). Unverified users can sign in but are held on
  /// /verify-email, and their org isn't provisioned (Felt project, ClickUp
  /// list) until the owner verifies.
  emailVerifiedAt DateTime?
  role            Role      @default(MEMBER)
  orgId           String

  // Felt "Field Editor": this specific person holds a named Felt seat on the
  // org's Felt project. Seats are assigned manually in Felt by BC staff (no
  // API); these fields only record what was set there. Felt seats are
  // personal to one person and may not be shared (Felt ToS).
  feltSeat             Boolean     @default(false)
  feltAccess           FeltAccess?
  feltEmail            String?
  feltSeatSince        DateTime?
  /// BC staff tick this once the person has accepted Felt's invite email.
  feltInviteAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization            Organization             @relation(fields: [orgId], references: [id])
  arcgisLink              ArcGISAccountLink?
  sentInvites             OrgInvite[]              @relation("InvitedBy")
  mapGrants               FeltMapGrant[]
  emailVerificationTokens EmailVerificationToken[]
}

/// One-time email verification link. Only a SHA-256 hash of the token is
/// stored; the raw token exists only in the emailed link.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OrgInvite {
  id          String       @id @default(cuid())
  orgId       String
  email       String?
  role        Role         @default(MEMBER)
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String?
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model ArcGISAccountLink {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String
  orgId        String
  orgUrl       String
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id            String       @id @default(cuid())
  orgId         String
  clickupTaskId String?
  clickupStatus String?
  title         String
  description   String
  status        TicketStatus @default(OPEN)
  priority      Priority     @default(NORMAL)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  organization Organization           @relation(fields: [orgId], references: [id])
  comments     SupportTicketComment[]
}

model SupportTicketComment {
  id               String        @id @default(cuid())
  ticketId         String
  clickupCommentId String        @unique
  authorName       String
  body             String
  source           CommentSource
  createdAt        DateTime      @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

/// Registry of Felt maps and which org owns each. This table — not Felt — is
/// the tenant boundary: BC's Felt API token can reach every client's maps, so
/// every route resolves a Felt map id through here before calling Felt.
model FeltMap {
  id                  String        @id @default(cuid())
  orgId               String
  feltMapId           String        @unique
  title               String
  kind                FeltMapKind   @default(MAP)
  visibility          MapVisibility @default(RESTRICTED)
  /// When the map became PUBLIC (portal or Felt).
  publicSince         DateTime?
  /// Someone made the map public directly in Felt rather than from the portal.
  /// It stays public; this flags it for the org's admins and BC staff to review.
  madePublicInFelt    Boolean       @default(false)
  /// Offered to client orgs in the "New map" template gallery. Only maps in a
  /// BC-internal org (one with a BC staff account) may be templates, so a
  /// client's data can never be copied into another org.
  isTemplate          Boolean       @default(false)
  templateDescription String?
  thumbnailKey        String?
  /// Framing chosen in the portal viewer ({ latitude, longitude, zoom }) for
  /// thumbnail renders. Null = Felt's saved default view.
  thumbnailView       Json?
  // Per-map webhook signing key, encrypted with src/lib/encryption.ts.
  webhookSecretEnc    String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grants       FeltMapGrant[]
  uploads      MapUpload[]

  @@index([orgId])
}

/// A data upload (file or link) into a Felt map from the portal. Files go to
/// BC's S3 bucket first (size-limited presigned PUT), then Felt imports them
/// from a short-lived link; the S3 copy is deleted once Felt has finished.
/// Also the audit trail of who confirmed the data contains nothing sensitive.
model MapUpload {
  id                       String          @id @default(cuid())
  orgId                    String
  mapId                    String
  userId                   String?
  kind                     MapUploadKind
  layerName                String
  fileName                 String?
  sourceUrl                String?
  sizeBytes                BigInt?
  s3Key                    String?
  feltLayerId              String?
  status                   MapUploadStatus @default(PENDING_UPLOAD)
  error                    String?
  confirmedNoSensitiveData Boolean         @default(false)
  /// NEW creates a layer; REPLACE swaps the data of the layer created by
  /// `replacesUploadId` (its "origin" upload).
  mode                     MapUploadMode   @default(NEW)
  replacesUploadId         String?
  /// Origin uploads only: Felt imports from a permanent RippleMap address
  /// (/api/felt/sources/{sourceToken}/…), so the layer can be refreshed
  /// later with a new file. It answers only while armed (`sourceArmedUntil`)
  /// and redirects to `sourceKey`, the file currently being imported.
  sourceToken              String?         @unique
  sourceKey                String?
  sourceArmedUntil         DateTime?
  /// Replace uploads: when Felt was asked to refresh, to tell a finished
  /// refresh from the layer's previous state.
  refreshRequestedAt       DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  map FeltMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@index([mapId])
  @@index([orgId])
}

enum MapUploadMode {
  NEW
  REPLACE
  /// Records typed in the portal, added to the layer created by
  /// `replacesUploadId` (export current data, add rows, refresh).
  APPEND
}

enum MapUploadKind {
  FILE
  URL
}

enum MapUploadStatus {
  PENDING_UPLOAD
  IMPORTING
  COMPLETED
  FAILED
}

/// Per-user view access to a RESTRICTED map. OWNER/ADMIN (and BC_STAFF) see
/// every map without a grant. A grant's user and map must be in the same org —
/// enforced in src/lib/felt/access.ts, since Prisma can't express it.
model FeltMapGrant {
  id          String   @id @default(cuid())
  mapId       String
  userId      String
  canExport   Boolean  @default(false)
  grantedById String?
  createdAt   DateTime @default(now())

  map  FeltMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mapId, userId])
  @@index([userId])
}

/// Billing terms for an org, maintained by BC staff in the admin portal until a
/// payment provider (Stripe) is integrated. Classification: Confidential
/// (pricing) plus PII (billing contact). Never store card numbers, bank account
/// numbers, or other financial account data here — BC policy prohibits it.
model OrgBilling {
  id                  String        @id @default(cuid())
  orgId               String        @unique
  plan                String?
  status              BillingStatus @default(TRIAL)
  cycle               BillingCycle?
  /// Price per billing cycle, in cents (USD).
  amountCents         Int?
  /// Felt seats included in the plan (Field Editors).
  feltSeats           Int           @default(1)
  startDate           DateTime?
  renewalDate         DateTime?
  billingContactName  String?
  billingContactEmail String?
  /// Internal BC notes. Never shown to the client.
  staffNotes          String?
  updatedById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model OnboardingState {
  id             String   @id @default(cuid())
  orgId          String   @unique
  currentStep    Int      @default(0)
  completedSteps String[]
  completed      Boolean  @default(false)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum OrgType {
  NONPROFIT
  CORPORATE
}

enum BillingStatus {
  /// Free tier. Orgs with no billing record are also treated as Free.
  FREE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum FeltMapKind {
  MAP
  DASHBOARD
  SURVEY
}

enum MapVisibility {
  RESTRICTED
  ALL_MEMBERS
  /// Anyone with the link can view, no sign-in (Felt public_access view_only).
  PUBLIC
}

enum FeltAccess {
  EDIT
  CONTRIBUTE
}

enum MediaSource {
  S3
  ARCGIS
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  BC_STAFF
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CommentSource {
  CLIENT
  BC_STAFF
}

/// A message sent from the public contact form. Customer PII (name, email):
/// staff-only, never shown in the client portal, deleted automatically after
/// CONTACT_RETENTION_MONTHS (src/lib/contact.ts) or sooner from admin.
model ContactSubmission {
  id           String        @id @default(cuid())
  name         String
  email        String
  organization String
  website      String?
  role         String?
  orgType      String?
  interest     String?
  message      String?
  status       ContactStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([createdAt])
  @@index([email, createdAt])
}

enum ContactStatus {
  NEW
  CONTACTED
  CLOSED
}
